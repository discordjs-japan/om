{
  "name": "om",
  "version": "0.7.0",
  "description": "TTS Bot for Discord.js Japan User Group",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "run-s build start:dev",
    "build": "rolldown --config",
    "start": "node dist/main.js",
    "start:dev": "node --enable-source-maps --env-file=.env dist/main.js",
    "check": "run-s -c *:check",
    "fix": "run-s -c *:fix",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "lint:check": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "node .husky/install.mjs",
    "test": "vitest",
    "test:ci": "vitest run"
  },
  "author": "Discord.js Japan User Group (discordjs-japan.org)",
  "license": "MIT",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "npm",
      "onFail": "warn"
    }
  },
  "devDependencies": {
    "@tsconfig/node26": "26.0.1",
    "@types/node": "26.6.6",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "npm-run-all2": "9.0.4",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2006",
    "rolldown": "1.2.16",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@discordjs-japan/om-syrinx": "github:discordjs-japan/om-syrinx#v0.5.3",
    "@discordjs/voice": "0.19.2",
    "@snazzah/davey": "0.2.0",
    "discord-markdown-parser": "1.3.1",
    "discord.js": "14.28.1",
    "pino": "10.4.0"
  },
  "allowScripts": {
    "github:discordjs-japan/om-syrinx#e6932946f173b9fb41def87b734d8577e024cb00": true
  }
}
