{
  "name": "om",
  "version": "0.7.0",
  "description": "TTS Bot for Discord.js Japan User Group",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "run-s build start:dev",
    "build": "rolldown --config",
    "start": "node dist/main.js",
    "start:dev": "node --enable-source-maps --env-file=.env dist/main.js",
    "check": "run-s -c *:check",
    "fix": "run-s -c *:fix",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "lint:check": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "node .husky/install.mjs",
    "test": "vitest",
    "test:ci": "vitest run"
  },
  "author": "Discord.js Japan User Group (discordjs-japan.org)",
  "license": "MIT",
  "devDependencies": {
    "@tsconfig/node24": "24.0.5",
    "@types/node": "24.13.3",
    "husky": "9.1.7",
    "lint-staged": "17.5.0",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "rolldown": "1.2.8",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "@discordjs-japan/om-syrinx": "github:discordjs-japan/om-syrinx#v0.5.3",
    "@discordjs/voice": "0.19.2",
    "@snazzah/davey": "0.1.12",
    "discord-markdown-parser": "1.3.1",
    "discord.js": "14.27.0",
    "pino": "10.3.1"
  },
  "allowScripts": {
    "github:discordjs-japan/om-syrinx#e6932946f173b9fb41def87b734d8577e024cb00": true
  }
}
